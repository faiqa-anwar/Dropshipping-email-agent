# Copy this file to .env (or just set these as real environment variables)
# and fill in whichever integrations you're using. Nothing here is required -
# the whole system runs on mocks if none of these are set.

# --- LLM (pick one; OpenRouter checked first if both are set) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# --- Supabase (run supabase_schema.sql in your project first) ---
SUPABASE_URL=
SUPABASE_KEY=
# Direct Postgres connection string, needed only for the Vercel deployment
# (api/index.py) since serverless functions need a persistent external
# checkpointer instead of local SQLite/in-memory. Find this at:
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
SUPABASE_DB_URL=

# --- Slack (not yet wired to a real client - see notify_clients.py) ---
SLACK_BOT_TOKEN=
